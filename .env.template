# Rever Environment Configuration
# Copy this to .env and fill in your keys

# Supabase (get from Settings → API in Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Firebase (get from Firebase Console → Project Settings → General)
# Android: Download google-services.json → place in android/app/
# iOS: Download GoogleService-Info.plist → place in ios/Runner/

# Google Sign-In (get from Google Cloud Console → Credentials)
# Create OAuth 2.0 Client ID for Web application type
GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com

# OpenAI (get from platform.openai.com → API keys)
OPENAI_API_KEY=sk-...
